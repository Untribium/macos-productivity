# Hammerspoon installs Spoons into ~/.hammerspoon/Spoons at runtime.
# bootstrap.sh leaves that directory alone; it is not part of this repo.
hammerspoon/Spoons/
.DS_Store

# Written by the running config (modules/diag.lua, urlctl.lua); machine state, not config.
.live/

# Machine-local values (email etc.), read by modules via require("config.local").
hammerspoon/config/local.lua

# Throwaway probe code; findings go in docs/verification/.
hammerspoon/probes/active.lua
